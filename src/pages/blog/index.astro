---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ArticleCard from "../../components/ArticleCard.astro";
import { getArticles } from "../../lib/content";
const articles = (await getArticles()).filter((article) => article.contentType === "blog");
---
<BaseLayout title="Blog | Infinity ERP" description="Ideas, insights, and practical ERP guidance from Infinity ERP.">
  <section class="container listing section"><p class="eyebrow">Ideas &amp; insights</p><h1>Blog</h1><p class="intro">Practical perspectives on operations, finance, and getting more from your ERP.</p><div class="card-grid">{articles.map((article) => <ArticleCard article={article} />)}</div></section>
</BaseLayout>
